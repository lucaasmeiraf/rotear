POSTGRES_USER=rotear
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=rotear
DATABASE_URL=postgresql://rotear:troque-esta-senha@db:5432/rotear
# Chave para assinar o cookie de sessão (gere com: openssl rand -hex 32)
SECRET_KEY=troque-esta-chave
OSRM_URL=http://osrm:5000
# Mantenha true. Em dev, acesse por http://localhost:8001 (túnel SSH): o navegador aceita cookie Secure em localhost.
COOKIE_SECURE=true

# Geocodificação: "nominatim" (padrão) ou "falso" (só para testes)
GEOCODIFICADOR=nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Obrigatório para o Nominatim: e-mail de contato enviado no User-Agent e no parâmetro email.
# Sem ele, a geocodificação fica desligada. Leia antes: https://operations.osmfoundation.org/policies/nominatim/
NOMINATIM_EMAIL=
# Área coberta pelo OSRM (minlon,minlat,maxlon,maxlat): prioriza resultados e marca os que ficarem fora
REGIAO_BBOX=-48.6384,-17.3761,-46.8150,-14.5160
